{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "packages": {
    "npm": {
      "package-name": "zcode-acp-martty",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "zcode",
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        {
          "type": "generic",
          "path": "/Cargo.toml"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name=='deepseek-harness-tui')].version"
        }
      ]
    }
  }
}
